# ==============================================================================
# NFC Media Controller - Environment Variables Example
# ==============================================================================
# Copy this file to .env for local adjustments.

# Timezone
TZ=Europe/Berlin

# MQTT Broker
MQTT_BROKER=192.168.1.50
MQTT_PORT=1883
MQTT_USER=nfc_user
MQTT_PASSWORD=secret_password
MQTT_CLIENT_ID=nfc_media_middleware
MQTT_TOPIC_SCANNED=rfid/scanned
MQTT_TOPIC_ACTION=rfid/action

# Audiobookshelf Server
ABS_BASE_URL=http://192.168.1.50:13378
ABS_DEFAULT_TOKEN=your_abs_token_here
ABS_TIMEOUT=3.0

# Media & Warnings
WARNING_SOUND_URI=http://homeassistant.local:8123/local/sounds/tag_unknown.mp3
DEFAULT_VOLUME=20
INTEGRATION_MODE=mass

# Web Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
LOG_LEVEL=INFO
